<?xml version="1.0" encoding="utf-8"?>
<!-- Home Jellyfin servers usually answer over HTTP on the local network (e.g. http://192.168.0.10:8096),
     and the address is typed in by the user, so HTTP is allowed. Prefer HTTPS away from home. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- certificates installed by the user (server with its own CA) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
